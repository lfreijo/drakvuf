+/* Type 27 -- Cooling Device.
+ * Passthrough-only. Backs Win32_Fan; defeats al-khaser
+ * "Cooling Device" GEN_SANDBOX check (MAP-1822).
+ *
+ * The structure may reference a Type 28 (Temperature Probe) by handle, so
+ * the firmware blob should emit Type 28 before Type 27 (gen-smbios-firmware.py
+ * does this; SMBIOS forward-handle references are otherwise legal but more
+ * fragile across consumers).
+ */
+static void *
+smbios_type_27_init(void *start)
+{
+    struct smbios_structure_header *p = (struct smbios_structure_header *)start;
+    void *pts;
+    uint32_t length;
+
+    pts = get_smbios_pt_struct(27, &length);
+    if ( (pts != NULL) && (length > 0) )
+    {
+        memcpy(start, pts, length);
+        p->handle = SMBIOS_HANDLE_TYPE27;
+        return (start + length);
+    }
+
+    return start;
+}
