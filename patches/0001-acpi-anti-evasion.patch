# 0001-acpi-anti-evasion.patch
#
# Anti-evasion ACPI table modifications for Xen HVM guests, per MAP-1793.
#
# al-khaser's firmware_ACPI() check (al-khaser/AntiVM/Generic.cpp) flags a
# guest as a VM if any of the following hold:
#   1. the literal ASCII bytes "WAET" appear in any ACPI table body
#   2. no WSMT table (signature 'TMSW' / 'WSMT') is present
#   3. FACP byte 45 (Preferred_PM_Profile) == 0 ("Unspecified")
#
# This patch addresses #3 only.
#
# v2 (2026-05-01): the previous version of this patch also addressed #1 and
# #2 -- it dropped WAET from hvmloader's table_flags OR-mask, added the WSMT
# table type (struct, signature/revision constants, static instance,
# constructor) and emitted WSMT from construct_secondary_tables(). All of
# the static analysis and code review for that combined change looked clean,
# and CI lint/compile/test-install all passed, but serv420 hit an early boot
# failure the first time it actually tried to run a Win10 HVM guest against
# the patched hvmloader: domain creates, qemu's VNC comes up, and the guest
# issues SHUTDOWN_poweroff (reason 0) before VGA init. Same symptom on every
# patched build pipeline (89-99). Vanilla hvmloader binary (md5
# 8b2803685481b72ee0f1ed73252b4cff -- copied from a serv4XX still on
# upstream Xen) immediately boots Win10 cleanly when dropped onto serv420
# in place of the 0001-patched binary (md5 0624ffbd4eeff3eaac9657c4f09ba7c3).
#
# Root cause not yet isolated. The visible suspects in the dropped scope are
# the new acpi_20_wsmt struct, the construct_wsmt() builder, and the
# WAET-suppression in hvmloader/util.c; all three need a real Win10 boot
# test before they can re-land. Re-introducing #1 and #2 is tracked
# separately and is gated on actually validating Win10 boot per addition.
#
# The FADT preferred_pm_profile byte change is a single-byte tweak to a
# static initializer with no allocation, no checksum, and no struct layout
# implication; safe to keep.
#
# Path: applied with `patch -p1` from the Xen source root inside Dockerfile-xen.

diff --git a/tools/libacpi/static_tables.c b/tools/libacpi/static_tables.c
index 715f46f..b387619 100644
--- a/tools/libacpi/static_tables.c
+++ b/tools/libacpi/static_tables.c
@@ -43,6 +43,12 @@ struct acpi_fadt Fadt = {
         .creator_revision = ACPI_CREATOR_REVISION
     },

+    /*
+     * Preferred_PM_Profile = 1 (Desktop). Anti-evasion: tools (e.g. al-khaser)
+     * treat 0 (Unspecified) as a sandbox indicator. ACPI 5.0 table 5-34.
+     */
+    .preferred_pm_profile = 1,
+
     .sci_int = 9,

     .pm1a_evt_blk = ACPI_PM1A_EVT_BLK_ADDRESS_V1,
