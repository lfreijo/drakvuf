# 0003-cpuid-stealth.patch
#
# MAP-1793: hide the hypervisor from guest CPUID at the Xen level.
#
# Replaces the DRAKVUF cpuidmon `-s` (stealth) plugin invocation, which did
# the same masking but via the vm_event ring -- adding a userspace round-trip
# (~100k-200k cycles) to every guest CPUID instruction. That round-trip was
# tripping al-khaser TIMING_ATTACKS test #11 (rdtsc; cpuid; rdtsc).
#
# Effect on guest:
#   * leaf 0x1 ECX bit 31 (HYPERVISOR_PRESENT) -> 0
#   * leaves 0x40000000-0x40000004 -> all four regs zeroed
#
# Effect on the al-khaser GEN_SANDBOX checks we care about:
#   * "Checking if CPU hypervisor field is set using cpuid(0x1) -> 0"      PASS
#   * "Checking hypervisor vendor using cpuid(0x40000000)        -> 0"      PASS
#
# Effect on TIMING_ATTACKS test #11: cpuidmon can be removed from drakrun's
# plugin list, eliminating the userspace ring round-trip; CPUID exits drop
# to plain-Xen latency (~1500-4000 cycles) which combined with the v3 RDTSC
# patch is below al-khaser's ~1000-cycle threshold.
#
# Side-effect: cpuidmon's per-CPUID JSON event stream is gone. cpuidmon was
# only ever used for stealth in this deployment, so dropping it is a net win.
#
# Path: applied with `patch -p1` from the Xen source root inside Dockerfile-xen.

diff --git a/xen/arch/x86/hvm/hvm.c b/xen/arch/x86/hvm/hvm.c
index 0f06307..07e6bfd 100644
--- a/xen/arch/x86/hvm/hvm.c
+++ b/xen/arch/x86/hvm/hvm.c
@@ -3546,6 +3546,32 @@ int hvm_vmexit_cpuid(struct cpu_user_regs *regs, unsigned int inst_len)
     regs->rcx = res.c;
     regs->rdx = res.d;
 
+    /*
+     * MAP-1793: anti-evasion CPUID stealth (replaces DRAKVUF cpuidmon -s).
+     *   * leaf 0x1 ECX bit 31: HYPERVISOR_PRESENT. al-khaser GEN_SANDBOX uses
+     *     this as the canonical "am I in a VM?" check.
+     *   * leaves 0x40000000-0x40000004: Xen's hypervisor-vendor identification
+     *     ("XenVMMXenVMM" signature). Clearing the leaves makes the guest see
+     *     a vendor-less response, which al-khaser's "hypervisor vendor using
+     *     cpuid(0x40000000)" check treats as not-a-VM.
+     *
+     * Doing this in Xen instead of via the DRAKVUF cpuidmon vm_event monitor
+     * saves the ~100k-cycle userspace ring round-trip per CPUID -- which was
+     * itself tripping al-khaser TIMING_ATTACKS test #11 (rdtsc; cpuid; rdtsc).
+     * Side-effect: drops cpuidmon's per-CPUID JSON event stream. cpuidmon was
+     * only ever used for stealth in this deployment, so that's fine.
+     */
+    if ( leaf == 0x1U )
+        regs->rcx &= ~0x80000000U;
+
+    if ( leaf >= 0x40000000U && leaf <= 0x40000004U )
+    {
+        regs->rax = 0;
+        regs->rbx = 0;
+        regs->rcx = 0;
+        regs->rdx = 0;
+    }
+
     return hvm_monitor_cpuid(inst_len, leaf, subleaf);
 }
 
