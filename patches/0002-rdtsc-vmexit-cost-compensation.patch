# 0002-rdtsc-vmexit-cost-compensation.patch (v4)
#
# MAP-1793: subtract the wall-clock cost of CPUID-induced VMEXITs from the
# guest-visible TSC so anti-VM tools (al-khaser test #11 "Checking RDTSC
# which force a VM Exit (cpuid)") can't use the elevated cycle delta as a
# sandbox tell.
#
# History:
#   v1 (in-handler): worked but only covered ~5-15k cycles. With DRAKVUF
#       cpuidmon active the bulk of the cost was the userspace ring
#       round-trip *after* the handler returned, so most of the cost
#       leaked through.
#   v3 (hvm_do_resume): tried to capture the post-pause window via the
#       scheduler resume path. Only fires when the vCPU is actually
#       descheduled, so once cpuidmon was dropped (no async pause) the
#       hook never ran and 0 cycles got subtracted.
#   v4 (this file): cpuidmon is gone -> there is no async pause -> the
#       in-handler window IS the entire CPUID VMEXIT cost. Reverts to
#       v1's structure: sample at handler entry, subtract at the end of
#       the switch, all synchronous, fires on every CPUID exit.
#
# Mechanism:
#   * After __vmread(VM_EXIT_REASON, ...), sample rdtsc_ordered() into a
#     local tc_vmexit_start_tsc.
#   * Just before the `out:` label, if the exit reason was CPUID, sample
#     rdtsc_ordered() again, compute (now - start), clamp, subtract from
#     v->arch.hvm.cache_tsc_offset, and write through to the VMCS via
#     hvm_set_tsc_offset(). Per-pCPU counter tc_vmexit_compensated_cycles
#     is bumped for diagnostics.
#
# Calibration (DRAKVUF on serv420 *without* cpuidmon, 4096-sample microbench):
#     pre-patch median 2360 cycles, p99 3348 (plain-Xen exit cost)
#     post-v4 expected: median <500 cycles -> al-khaser #11 PASS
#
# Tunables:
#   TC_VMEXIT_MIN_CYCLES        200     noise floor
#   TC_VMEXIT_MAX_ADJUST_CYCLES 524288  ~256us at 2GHz; sized to ride out
#                                       any rare outliers without billing
#                                       the guest for full preemption gaps.
#
# Path: applied with `patch -p1` from the Xen source root inside Dockerfile-xen.

diff --git a/xen/arch/x86/hvm/vmx/vmx.c b/xen/arch/x86/hvm/vmx/vmx.c
index 1373ef2..2f4881c 100644
--- a/xen/arch/x86/hvm/vmx/vmx.c
+++ b/xen/arch/x86/hvm/vmx/vmx.c
@@ -4058,6 +4058,27 @@ static void undo_nmis_unblocked_by_iret(void)
               guest_info | VMX_INTR_SHADOW_NMI);
 }
 
+/*
+ * MAP-1793 anti-evasion clamps for guest-visible CPUID VMEXIT cost.
+ *
+ * al-khaser test #11 ("Checking RDTSC which force a VM Exit (cpuid)")
+ * times (rdtsc; cpuid; rdtsc) and trips on avg > ~1000 cycles. Native
+ * CPUID is ~50-200 cycles, plain Xen HVM CPUID is ~1500-4000. We sample
+ * rdtsc_ordered() at handler entry, recompute at the end of the switch
+ * for CPUID exits, and subtract the cost from the vCPU's TSC offset.
+ *
+ * MIN: noise floor; below this the measurement is dominated by sample
+ *   skew and the cost is too small to matter for evasion checks.
+ * MAX: hard ceiling. Sized to fully cover plain-Xen p99 CPUID exits with
+ *   headroom but well below the multi-millisecond preemption tail, so we
+ *   don't credit the guest with a free time-warp on unrelated host activity.
+ *   524288 cycles == ~256us at 2GHz.
+ */
+#define TC_VMEXIT_MIN_CYCLES        200ULL
+#define TC_VMEXIT_MAX_ADJUST_CYCLES 524288ULL
+
+static DEFINE_PER_CPU(uint64_t, tc_vmexit_compensated_cycles);
+
 void asmlinkage vmx_vmexit_handler(struct cpu_user_regs *regs)
 {
     unsigned long exit_qualification, exit_reason, idtv_info, intr_info = 0;
@@ -4065,6 +4086,7 @@ void asmlinkage vmx_vmexit_handler(struct cpu_user_regs *regs)
     unsigned int vector = 0;
     struct vcpu *v = current;
     struct domain *currd = v->domain;
+    uint64_t tc_vmexit_start_tsc = 0;
 
     __vmread(GUEST_RIP,    &regs->rip);
     __vmread(GUEST_RSP,    &regs->rsp);
@@ -4093,6 +4115,13 @@ void asmlinkage vmx_vmexit_handler(struct cpu_user_regs *regs)
 
     __vmread(VM_EXIT_REASON, &exit_reason);
 
+    /*
+     * MAP-1793: sample TSC right after we know this is a VMEXIT but before
+     * any non-trivial handler work. Used below for CPUID exits to subtract
+     * the wall-clock cost from the guest TSC offset.
+     */
+    tc_vmexit_start_tsc = rdtsc_ordered();
+
     if ( hvm_long_mode_active(v) )
         TRACE_TIME(TRC_HVM_VMX_EXIT64, exit_reason, regs->rip, regs->rip >> 32);
     else
@@ -4747,6 +4776,38 @@ void asmlinkage vmx_vmexit_handler(struct cpu_user_regs *regs)
         break;
     }
 
+    /*
+     * MAP-1793: hide the CPUID VMEXIT cost from the guest TSC. al-khaser
+     * (and similar anti-VM checks) measure (rdtsc; cpuid; rdtsc) and
+     * compare the delta against ~1000 cycles. Subtract the actual cost
+     * we just incurred from the vCPU's cache_tsc_offset so the next guest
+     * RDTSC reads as if the exit never happened. Clamps preserve guest
+     * TSC monotonicity and reject preemption-induced outliers.
+     *
+     * Synchronous-only path: this fires for every CPUID exit, including
+     * those that don't trigger a vm_event-monitor pause/reschedule. Since
+     * this deployment dropped the cpuidmon plugin, the in-handler window
+     * IS the full guest-visible cost (~1500-4000 cycles plain Xen).
+     */
+    if ( (uint16_t)exit_reason == EXIT_REASON_CPUID && tc_vmexit_start_tsc )
+    {
+        uint64_t now = rdtsc_ordered();
+
+        if ( now > tc_vmexit_start_tsc )
+        {
+            uint64_t cost = now - tc_vmexit_start_tsc;
+
+            if ( cost > TC_VMEXIT_MIN_CYCLES )
+            {
+                if ( cost > TC_VMEXIT_MAX_ADJUST_CYCLES )
+                    cost = TC_VMEXIT_MAX_ADJUST_CYCLES;
+                v->arch.hvm.cache_tsc_offset -= cost;
+                hvm_set_tsc_offset(v, v->arch.hvm.cache_tsc_offset, 0);
+                this_cpu(tc_vmexit_compensated_cycles) += cost;
+            }
+        }
+    }
+
 out:
     if ( nestedhvm_vcpu_in_guestmode(v) )
         nvmx_idtv_handling();
