# 0002-rdtsc-vmexit-cost-compensation.patch (v3)
#
# MAP-1793: subtract the wall-clock cost of CPUID-induced VMEXITs from the
# guest-visible TSC so anti-VM tools (al-khaser test #11 "Checking RDTSC
# which force a VM Exit (cpuid)") can't use the elevated cycle delta as a
# sandbox tell.
#
# v1 sampled both timestamps inside vmx_vmexit_handler() and only captured
# the in-handler portion (~5-15k cycles). With DRAKVUF cpuidmon active,
# the bulk of the cost is the *monitor-induced pause + reschedule* that
# happens AFTER the handler returns -- v1 missed that.
#
# v3 mechanism:
#   * vmx_vmexit_handler() stamps `v->arch.hvm.tc_vmexit_start_tsc` for
#     CPUID exits only, immediately after VM_EXIT_REASON is read.
#   * hvm_do_resume() (which runs after any monitor pause + scheduler
#     activity, just before VMENTER) computes the elapsed cycles, clamps
#     them, subtracts from `v->arch.hvm.cache_tsc_offset`, writes through
#     to the VMCS via hvm_set_tsc_offset(), and clears the field.
#
# Calibration (DRAKVUF on serv420, 4096-sample microbench):
#     pre-patch median 167624 cycles, p99 510208
#     v1 patch  median 145604 cycles, p99 1174414  (only in-handler portion)
#     v3 target median <1000  cycles                (full exit-to-entry)
#
# Tunables in hvm_do_resume() body: MIN clamp (200 cycles, noise floor)
# and MAX clamp (4194304 cycles, ~2ms at 2GHz -- covers DRAKVUF tail
# without billing the guest for full scheduler-preemption gaps).
#
# Path: applied with `patch -p1` from the Xen source root inside Dockerfile-xen.

diff --git a/xen/arch/x86/hvm/hvm.c b/xen/arch/x86/hvm/hvm.c
index 0f06307..a6abc8c 100644
--- a/xen/arch/x86/hvm/hvm.c
+++ b/xen/arch/x86/hvm/hvm.c
@@ -547,6 +547,48 @@ void hvm_do_resume(struct vcpu *v)
             v->arch.monitor.next_interrupt_enabled = false;
         }
     }
+
+    /*
+     * MAP-1793: subtract the full CPUID-VMEXIT cost (handler + monitor
+     * pause + reschedule) from the guest TSC offset so the next guest
+     * RDTSC reads as if the exit never happened. This defeats al-khaser
+     * test #11 ("Checking RDTSC which force a VM Exit (cpuid)") which
+     * compares (rdtsc; cpuid; rdtsc) cycle deltas against ~1000 cycles.
+     *
+     * Calibration on serv420 (DRAKVUF + cpuidmon, 4096 samples):
+     *   pre-patch  median 167624  p99 510208
+     *   post-v1    median 145604  p99 1174414  (in-handler-only, missed pause)
+     * Most of the cost is the monitor-induced pause/reschedule, which only
+     * resolves by the time hvm_do_resume() runs -- hence the placement.
+     *
+     * Clamps:
+     *   MIN: noise floor; below this the cost is negligible and the rdtsc
+     *        sample noise dominates.
+     *   MAX: ceiling that covers DRAKVUF p99 with headroom but discards
+     *        full-scheduler-preemption outliers (multi-millisecond gaps),
+     *        so we don't credit the guest with a free time-warp on
+     *        unrelated host activity.
+     */
+    if ( v->arch.hvm.tc_vmexit_start_tsc )
+    {
+        uint64_t start = v->arch.hvm.tc_vmexit_start_tsc;
+        uint64_t now = rdtsc_ordered();
+
+        v->arch.hvm.tc_vmexit_start_tsc = 0;
+
+        if ( now > start )
+        {
+            uint64_t cost = now - start;
+
+            if ( cost > 200ULL )
+            {
+                if ( cost > 4194304ULL )
+                    cost = 4194304ULL;
+                v->arch.hvm.cache_tsc_offset -= cost;
+                hvm_set_tsc_offset(v, v->arch.hvm.cache_tsc_offset, 0);
+            }
+        }
+    }
 }
 
 static int cf_check hvm_print_line(
diff --git a/xen/arch/x86/hvm/vmx/vmx.c b/xen/arch/x86/hvm/vmx/vmx.c
index 1373ef2..3d67f8f 100644
--- a/xen/arch/x86/hvm/vmx/vmx.c
+++ b/xen/arch/x86/hvm/vmx/vmx.c
@@ -4093,6 +4093,15 @@ void asmlinkage vmx_vmexit_handler(struct cpu_user_regs *regs)
 
     __vmread(VM_EXIT_REASON, &exit_reason);
 
+    /*
+     * MAP-1793: stamp the host TSC at the start of a CPUID-induced VMEXIT.
+     * hvm_do_resume() will compute the elapsed cycles up to VMENTER and
+     * subtract them from the guest TSC offset, hiding the (potentially
+     * monitor-pause-amplified) exit cost from anti-VM cycle-delta checks.
+     */
+    if ( (uint16_t)exit_reason == EXIT_REASON_CPUID )
+        v->arch.hvm.tc_vmexit_start_tsc = rdtsc_ordered();
+
     if ( hvm_long_mode_active(v) )
         TRACE_TIME(TRC_HVM_VMX_EXIT64, exit_reason, regs->rip, regs->rip >> 32);
     else
diff --git a/xen/arch/x86/include/asm/hvm/vcpu.h b/xen/arch/x86/include/asm/hvm/vcpu.h
index 196fed6..92e900e 100644
--- a/xen/arch/x86/include/asm/hvm/vcpu.h
+++ b/xen/arch/x86/include/asm/hvm/vcpu.h
@@ -126,6 +126,15 @@ struct hvm_vcpu {
     int64_t             cache_tsc_offset;
     uint64_t            guest_time;
 
+    /*
+     * MAP-1793: TSC sample taken at the start of a CPUID-induced VMEXIT,
+     * consumed by hvm_do_resume() to subtract the full exit-to-entry cost
+     * (including any monitor-induced pause/reschedule) from the guest TSC
+     * offset. Defeats al-khaser test #11 (rdtsc; cpuid; rdtsc) and similar
+     * cycle-delta sandbox checks. Zero when no compensation is pending.
+     */
+    uint64_t            tc_vmexit_start_tsc;
+
     /* Lock and list for virtual platform timers. */
     spinlock_t          tm_lock;
     struct list_head    tm_list;
