# 0002-rdtsc-vmexit-cost-compensation.patch (v5 - DEBUG)
#
# v4's measured-cost subtraction compiled in correctly (verified via
# objdump on the deployed xen-syms) but had no observable effect on the
# guest-visible RDTSC delta. Either the offset write isn't reaching the
# live VMCS, or the magnitude is too small for al-khaser's averaging.
#
# v5 makes both possibilities decisive:
#   - Hardcoded 1,000,000-cycle subtraction per CPUID exit (no measurement)
#   - Direct __vmwrite(TSC_OFFSET, ...) bypassing hvm_set_tsc_offset()
#
# Expected behavior:
#   - rdtsc-bench median drops to 0 (clamped via (t2 >= t1) ? : 0) -> v4
#     was just under-subtracting; switch back to dynamic measurement with
#     a much more aggressive multiplier in v6.
#   - rdtsc-bench median stays ~2300 -> the offset write isn't reaching
#     the live VMCS at all; need a different approach (e.g. modify VMCS
#     fields via a vm_event hook, or different VMCS field, etc).
#
# This is INTENTIONALLY destructive of guest TSC monotonicity for the
# duration of validation. Do NOT ship to production while this is in.
#
# Path: applied with `patch -p1` from the Xen source root inside Dockerfile-xen.

diff --git a/xen/arch/x86/hvm/vmx/vmx.c b/xen/arch/x86/hvm/vmx/vmx.c
index 1373ef2..f5fd88e 100644
--- a/xen/arch/x86/hvm/vmx/vmx.c
+++ b/xen/arch/x86/hvm/vmx/vmx.c
@@ -4058,6 +4058,35 @@ static void undo_nmis_unblocked_by_iret(void)
               guest_info | VMX_INTR_SHADOW_NMI);
 }
 
+/*
+ * MAP-1793 v5: aggressive in-handler TSC offset compensation, direct __vmwrite.
+ *
+ * v4 used hvm_set_tsc_offset() (an indirect call through hvm_funcs) and a
+ * dynamically-measured cost. Disasm confirmed the patch was compiled in and
+ * executed, but rdtsc-bench inside the guest showed unchanged median cycles --
+ * implying the offset write either wasn't reaching the in-memory VMCS or was
+ * being overwritten somewhere else before VMENTER. v5 short-circuits both
+ * possibilities:
+ *   - Hardcoded subtraction of TC_VMEXIT_FORCED_CYCLES (1,000,000 cycles --
+ *     ~500us at 2GHz). Guest RDTSC after CPUID will read ~1M cycles in the
+ *     *past* relative to before, and rdtsc-bench's clamp `(t2 >= t1) ? : 0`
+ *     will report 0 if the offset write took effect.
+ *   - Direct `__vmwrite(TSC_OFFSET, ...)` bypassing hvm_set_tsc_offset() so
+ *     there's no chance of dispatch table issues.
+ *
+ * If v5 produces median cycles near 0 in rdtsc-bench, we know the offset
+ * write is effective and v4's failure was due to magnitude (subtracted too
+ * little to overcome al-khaser's averaging). Switch back to dynamic
+ * measurement with a more aggressive multiplier.
+ *
+ * If v5 STILL produces median ~2300, the offset write isn't reaching the
+ * in-memory VMCS at all -- something more fundamental is broken (TSC scaling
+ * mode, CPU caching of VMCS fields, etc.).
+ */
+#define TC_VMEXIT_FORCED_CYCLES     1000000ULL
+
+static DEFINE_PER_CPU(uint64_t, tc_vmexit_compensated_cycles);
+
 void asmlinkage vmx_vmexit_handler(struct cpu_user_regs *regs)
 {
     unsigned long exit_qualification, exit_reason, idtv_info, intr_info = 0;
@@ -4747,6 +4776,22 @@ void asmlinkage vmx_vmexit_handler(struct cpu_user_regs *regs)
         break;
     }
 
+    /*
+     * MAP-1793 v5: forced TSC offset shift on every CPUID exit.
+     * Subtract a fixed 1M cycles directly via __vmwrite(TSC_OFFSET) and
+     * also update the cached value so future hvm_get_guest_tsc() agrees.
+     * If guest RDTSC after CPUID still reads ~2k cycles forward, the
+     * offset write isn't reaching the live VMCS.
+     */
+    if ( (uint16_t)exit_reason == EXIT_REASON_CPUID )
+    {
+        uint64_t new_offset = v->arch.hvm.cache_tsc_offset - TC_VMEXIT_FORCED_CYCLES;
+
+        v->arch.hvm.cache_tsc_offset = new_offset;
+        __vmwrite(TSC_OFFSET, new_offset);
+        this_cpu(tc_vmexit_compensated_cycles) += TC_VMEXIT_FORCED_CYCLES;
+    }
+
 out:
     if ( nestedhvm_vcpu_in_guestmode(v) )
         nvmx_idtv_handling();
